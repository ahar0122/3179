{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 600,
  "height": 450,
  "title": "Proportion of Australians who drink Alcohol daily",
  "projection": {"type": "mercator"},
  "params": [
    {
      "name": "selectedYear",
      "value": 2023,
      "bind": {
        "input": "select",
        "options": [2001, 2004, 2007, 2010, 2013, 2016, 2019, 2023],
        "name": "Year: "
      }
    }
  ],
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/ahar0122/3179/refs/heads/main/STE_2016_AUST.json",
        "format": {"type": "topojson", "feature": "STE_2016_AUST"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e6e6e6",
        "stroke": "white",
        "strokeWidth": 1.5
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/ahar0122/3179/refs/heads/main/choropleth%20map%20data%20alcohol%20over%20the%20years.csv",
        "format": {"type": "csv"}
      },
      "transform": [
        {"calculate": "trim(datum.state)", "as": "stateName"},
        {"calculate": "toNumber(datum.year)", "as": "yr"},
        {"calculate": "toNumber(datum.proportion)", "as": "value"},
        {"filter": "datum.yr === toNumber(selectedYear)"},
        {
          "lookup": "stateName",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/ahar0122/3179/refs/heads/main/STE_2016_AUST.json",
              "format": {"type": "topojson", "feature": "STE_2016_AUST"}
            },
            "key": "properties.STE_NAME16"
          },
          "as": "geo"
        }
      ],
      "mark": {"type": "geoshape", "stroke": "white", "strokeWidth": 1.5},
      "encoding": {
        "shape": {"field": "geo", "type": "geojson"},
        "color": {
          "field": "proportion",
          "type": "quantitative",
          "scale": {"scheme": "blues", "domain": [3, 11]},
          "legend": {"title": "Proportion (%)"}
        },
        "tooltip": [
          {"field": "state", "type": "nominal", "title": "State or Territory"},
          {"field": "year", "type": "ordinal", "title": "Year"},
          {
            "field": "proportion",
            "type": "quantitative",
            "title": "Proportion (%)"
          }
        ]
      }
    }
  ],
  "config": {}
}