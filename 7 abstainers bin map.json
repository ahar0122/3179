{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Alcohol Abstainers Across Australia",
    "subtitle": "Percentage of people abstaining from alcohol by state and territory",
    "anchor": "start",
    "fontSize": 20
  },
  "width": 500,
  "height": 500,
  "data": {
    "url": "https://raw.githubusercontent.com/ahar0122/3179/refs/heads/main/abstainers_by_state.csv",
    "format": {"type": "csv"}
  },
  "params": [
    {
      "name": "selectedYear",
      "value": "2022–2023",
      "bind": {
        "input": "select",
        "options": ["2007", "2010", "2013", "2016", "2019", "2022–2023"],
        "name": "Reporting year: "
      }
    }
  ],
  "transform": [
    {"filter": "datum.year === selectedYear"},
    {
      "calculate": "datum.state === 'Western Australia' ? 0 : datum.state === 'South Australia' ? 1 : datum.state === 'Northern Territory' ? 1 : datum.state === 'Queensland' ? 2 : datum.state === 'Victoria' ? 2 : datum.state === 'New South Wales' ? 3 : datum.state === 'Australian Capital Territory' ? 4 : 3",
      "as": "map_x"
    },
    {
      "calculate": "datum.state === 'Northern Territory' ? 0 : datum.state === 'Queensland' ? 0 : datum.state === 'Western Australia' ? 1 : datum.state === 'South Australia' ? 1 : datum.state === 'New South Wales' ? 1 : datum.state === 'Australian Capital Territory' ? 2 : datum.state === 'Victoria' ? 2 : 3",
      "as": "map_y"
    },
    {"calculate": "datum.map_x + 1", "as": "map_x2"},
    {"calculate": "datum.map_y + 1", "as": "map_y2"},
    {"calculate": "datum.map_x + 0.5", "as": "label_x"},
    {"calculate": "datum.map_y + 0.5", "as": "label_y"},
    {
      "calculate": "datum.state === 'New South Wales' ? 'NSW' : datum.state === 'Victoria' ? 'VIC' : datum.state === 'Queensland' ? 'QLD' : datum.state === 'Western Australia' ? 'WA' : datum.state === 'South Australia' ? 'SA' : datum.state === 'Tasmania' ? 'TAS' : datum.state === 'Australian Capital Territory' ? 'ACT' : 'NT'",
      "as": "state_abbr"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rect",
        "cornerRadius": 8,
        "stroke": "#FFFFFF",
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "map_x",
          "type": "quantitative",
          "scale": {"domain": [0, 5], "nice": false, "zero": false},
          "axis": null
        },
        "x2": {"field": "map_x2"},
        "y": {
          "field": "map_y",
          "type": "quantitative",
          "scale": {"domain": [4, 0], "nice": false, "zero": false},
          "axis": null
        },
        "y2": {"field": "map_y2"},
        "color": {
          "field": "abstainers_percent",
          "type": "quantitative",
          "scale": {
            "domain": [10, 30],
            "range": ["#F5E6E6", "#7D2638"],
            "clamp": true
          },
          "legend": {"title": "Abstainers (%)", "format": ".0f"}
        },
        "tooltip": [
          {"field": "state", "type": "nominal", "title": "State / territory"},
          {"field": "year", "type": "nominal", "title": "Year"},
          {
            "field": "abstainers_percent",
            "type": "quantitative",
            "title": "Abstainers (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 16,
        "fontWeight": "bold",
        "color": "#202C3B",
        "dy": -10
      },
      "encoding": {
        "x": {
          "field": "label_x",
          "type": "quantitative",
          "scale": {"domain": [0, 5], "nice": false, "zero": false},
          "axis": null
        },
        "y": {
          "field": "label_y",
          "type": "quantitative",
          "scale": {"domain": [4, 0], "nice": false, "zero": false},
          "axis": null
        },
        "text": {"field": "state_abbr", "type": "nominal"}
      }
    },
    {
      "mark": {"type": "text", "fontSize": 15, "color": "#202C3B", "dy": 13},
      "encoding": {
        "x": {
          "field": "label_x",
          "type": "quantitative",
          "scale": {"domain": [0, 5], "nice": false, "zero": false},
          "axis": null
        },
        "y": {
          "field": "label_y",
          "type": "quantitative",
          "scale": {"domain": [4, 0], "nice": false, "zero": false},
          "axis": null
        },
        "text": {
          "field": "abstainers_percent",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    }
  ],
  "config": {"view": {"stroke": null}}
}